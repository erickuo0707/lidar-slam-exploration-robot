<launch>
  <arg name="world" default="$(find my_robot_sim)/worlds/office.world"/>
  <arg name="start_explorer" default="true"/>
  <arg name="start_ai_observer" default="false"/>
  <arg name="gui" default="true"/>

  <param name="use_sim_time" value="true"/>

  <include file="$(find gazebo_ros)/launch/empty_world.launch">
    <arg name="world_name" value="$(arg world)"/>
    <arg name="paused" value="false"/>
    <arg name="use_sim_time" value="true"/>
    <arg name="gui" value="$(arg gui)"/>
  </include>

  <param name="robot_description" textfile="$(find my_robot_sim)/urdf/tinker_car.urdf"/>
  <node pkg="robot_state_publisher" type="robot_state_publisher" name="robot_state_publisher" output="screen"/>
  <node pkg="gazebo_ros" type="spawn_model" name="spawn_tinker_car" output="screen"
        args="-urdf -param robot_description -model tinker_car -x 0 -y 0 -z 0.06"/>

  <node pkg="hector_mapping" type="hector_mapping" name="hector_mapping" output="screen">
    <param name="pub_map_odom_transform" value="true"/>
    <param name="map_frame" value="map"/>
    <param name="base_frame" value="base_link"/>
    <param name="odom_frame" value="odom"/>
    <param name="map_resolution" value="0.05"/>
    <param name="map_size" value="1024"/>
    <param name="map_start_x" value="0.5"/>
    <param name="map_start_y" value="0.5"/>
    <param name="map_multi_res_levels" value="3"/>
    <param name="map_update_distance_thresh" value="0.20"/>
    <param name="map_update_angle_thresh" value="0.20"/>
    <param name="update_factor_free" value="0.4"/>
    <param name="update_factor_occupied" value="0.9"/>
    <param name="laser_min_dist" value="0.15"/>
    <param name="laser_max_dist" value="5.5"/>
    <param name="scan_topic" value="/scan"/>
  </node>

  <node if="$(arg start_explorer)" pkg="my_robot" type="smart_explorer.py"
        name="smart_explorer" output="screen"/>
  <node if="$(arg start_ai_observer)" pkg="my_robot" type="ai_observer.py"
        name="ai_observer" output="screen"/>
</launch>
